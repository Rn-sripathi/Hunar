# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Every variable here is validated at startup by app.core.config.Settings,
# so a missing or malformed value fails fast rather than at first use.

# ─────────────────────────────────────────────────────────────
# Hunar Voice API
# ─────────────────────────────────────────────────────────────
# From the Hunar dashboard. This same key is ALSO the HMAC secret used to
# verify inbound webhook signatures, so it must never leave the backend.
HUNAR_API_KEY=hunar_live_replace_me
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1/

# Comma-separated older keys, kept only so webhooks signed with a rotated
# key still verify during the overlap window. Usually empty.
HUNAR_API_KEYS_PREVIOUS=

# live  = always call the real API
# mock  = never touch the network; the fake client drives the full lifecycle
# auto  = start live, latch to mock on the first 401/402 and show a banner
# Deploy with `auto` so the demo survives key expiry.
HUNAR_MODE=auto

# per_job = one Hunar agent per job role (default, required for per-job
#           result_schema). `shared` is an escape hatch if the org turns
#           out to cap agent count.
HUNAR_AGENT_STRATEGY=per_job

# Hunar retries webhooks at 1, 2, 4 and 8 minutes. The 8-minute retry
# exceeds a 300s window, so widen this if retries are being rejected.
WEBHOOK_MAX_SKEW_SECONDS=300

# ─────────────────────────────────────────────────────────────
# Public URL — the root of every webhook callback URL we hand Hunar.
# MUST be https and MUST be reachable from the internet.
# Local dev: an ngrok reserved domain. Production: the Render URL.
# ─────────────────────────────────────────────────────────────
PUBLIC_API_BASE_URL=https://your-subdomain.ngrok-free.app

# ─────────────────────────────────────────────────────────────
# Database — Neon Postgres
# Use the DIRECT (unpooled) endpoint for Alembic migrations; the pooled
# endpoint breaks prepared statements under asyncpg.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/hunar?ssl=require

# ─────────────────────────────────────────────────────────────
# People search (app 2)
# pdl | pdl_sandbox | fixture   — independent of HUNAR_MODE on purpose,
# so a voice-key expiry does not force fake people data.
# ─────────────────────────────────────────────────────────────
PEOPLE_PROVIDER=pdl
PDL_API_KEY=replace_me
PEOPLE_MAX_RECORDS_PER_SEARCH=25
PEOPLE_DAILY_CREDIT_CAP=40

# ─────────────────────────────────────────────────────────────
# Consent allowlist — THE outbound calling gate for app 2.
# Only these E.164 numbers can ever be dialled. Comma-separated
# `+91XXXXXXXXXX|Label` pairs. Kept in env, never in the repo.
# ─────────────────────────────────────────────────────────────
DEMO_ALLOWLIST=+919999999999|My test phone

# Calls are only placed inside this window, in Asia/Kolkata.
CALLING_HOURS_START=10:00
CALLING_HOURS_END=19:00
CALLING_TIMEZONE=Asia/Kolkata

# ─────────────────────────────────────────────────────────────
# LLM — turns a job description into screening questions and search filters
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace_me
LLM_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Single shared password gating the public demo. Webhook and health
# paths are exempt. Not real auth; it just keeps the URL from being open.
DEMO_PASSWORD=change_me
SESSION_SECRET=generate_with_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────
# Frontend (apps/web). Only NEXT_PUBLIC_* reaches the browser —
# never put the Hunar key here.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
