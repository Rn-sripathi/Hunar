    "eslint-config-next": "16.3.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
